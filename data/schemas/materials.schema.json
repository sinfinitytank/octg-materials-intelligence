              },
              "heatTreatment": {
                "type": "null"
              },
              "chemistry": {
                "type": "object",
                "maxProperties": 0
              },
              "environmentalEnvelope": {
                "type": "null"
              }
            },
            "additionalProperties": false
          },
          "limitations": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "raw": {
            "type": "object",
            "required": [
              "ID",
              "Supplier",
              "Region",
              "Grade",
              "Listing type",
              "Standard context",
              "Material family",
              "Service / use",
              "Typical application",
              "H2S suitability",
              "CO2 corrosion",
              "High collapse",
              "SMYS ksi",
              "UNS",
              "5CRA Group",
              "5CRA Category",
              "Relative cost tier",
              "Price low USD/t",
              "Price high USD/t",
              "Price evidence",
              "Vendor quote USD/t",
              "Source URL",
              "Source status",
              "Technical notes",
              "Reviewed"
            ],
            "properties": {
              "ID": {
                "type": "string"
              },
              "Supplier": {
                "type": "string"
              },
              "Region": {
                "type": "string"
              },
