{
  "name": "octg-materials-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Traceable OCTG materials intelligence and preliminary engineering screening",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:import": "python3 scripts/import_data.py",
    "data:validate": "python3 scripts/validate_data.py",
    "data:test": "python3 scripts/test_data_validation.py",
    "check": "npm run data:validate && npm run data:test && npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json *.md docs/*.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json *.md docs/*.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  }
}
